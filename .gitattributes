# ============================================================
# Git LFS — 대용량 파일 (GitHub 100 MB 단일 파일 제한 회피)
# ============================================================
*.pptx filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text

# ============================================================
# 텍스트 파일 인코딩 — Windows CRLF → Unix LF 변환 안 함 (원본 보존)
# ============================================================
*.java text eol=lf
*.ino text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.json text eol=lf
*.md text eol=lf
*.js text eol=lf
*.properties text eol=lf
*.txt text eol=lf

# ============================================================
# 바이너리 명시 (Git 자동 감지 보조)
# ============================================================
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.zip binary
*.apk binary
*.docx binary
*.hwp binary
*.hwpx binary
